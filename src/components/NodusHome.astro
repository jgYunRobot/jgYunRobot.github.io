---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import "@/styles/nodus-home.css";
import config from "@/config";
import NodusExperience from "@/components/NodusExperience.astro";
import desktopDarkPoster from "@/assets/title-posters/nodus-title-desktop-dark.webp?inline";
import mobileDarkPoster from "@/assets/title-posters/nodus-title-mobile-dark.webp?inline";

type Props = { posts: CollectionEntry<"posts">[] };
const { posts } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: config.site.timezone,
});
const readableDateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: config.site.timezone,
});
const projects = posts.map(post => {
  const timelineAt = post.data.homeDate ?? post.data.pubDatetime;
  const parts = Object.fromEntries(
    dateFormatter
      .formatToParts(timelineAt)
      .map(({ type, value }) => [type, value])
  );
  return {
    post,
    title: post.data.homeTitle ?? post.data.title,
    category: post.data.homeCategory ?? post.data.category,
    coverAlt: post.data.homeCoverAlt ?? post.data.coverAlt ?? post.data.title,
    timelineAt,
    timelineDate: `${parts.year}.${parts.month}.${parts.day}`,
    timelineLabel: readableDateFormatter.format(timelineAt),
  };
});
const initialProject = projects[projects.length - 1];
const digitSequence = Array.from({ length: 30 }, (_, index) => index % 10).join(
  "\n"
);
---

<div class="nodus-home" data-nodus-home>
  <canvas
    class="nodus-surface nodus-home-surface"
    width="1"
    height="1"
    data-surface-color="#080b0e"
    aria-hidden="true"></canvas>
  <a class="nodus-skip" href="#project-gallery">Skip to projects</a>
  <header class="nodus-header">
    <a href="/" class="nodus-brand" aria-label="Project Nodus home">
      <span class="axis-brand-project">
        <svg viewBox="0 0 32 32" aria-hidden="true"
          ><path d="M7 24V8l18 16V8"></path><circle cx="7" cy="8" r="2.5"
          ></circle><circle cx="25" cy="24" r="2.5"></circle></svg
        >
        <span>Project <strong>Nodus</strong></span>
      </span>
      <span class="axis-career-brand" aria-hidden="true"
        >Junggil Yun <small>Professional Experience</small></span
      >
    </a>
    <nav aria-label="Main navigation" class="nodus-nav">
      <a href="#project-gallery" aria-current="page">Projects</a>
      <a href="/posts/">Journal</a>
      <a href="/about/">About</a>
      <a href="/search/" class="nodus-search" aria-label="Search posts"
        ><svg viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4.5 4.5"
          ></path></svg
        ></a
      >
    </nav>
  </header>

  <main id="main-content" data-layout="index" data-home-path="/">
    <section class="nodus-hero" aria-labelledby="nodus-title">
      <div class="hero-ambient" aria-hidden="true"></div>

      <h1 id="nodus-title" class="nodus-accessible">Project Nodus</h1>
      <nodus-title class="nodus-title-stage" aria-hidden="true">
        <picture class="nodus-title-poster">
          <source
            media="(max-width: 640px)"
            srcset={mobileDarkPoster}
            width="572"
            height="325"
          />
          <img
            src={desktopDarkPoster}
            width="766"
            height="450"
            alt=""
            loading="eager"
            decoding="sync"
          />
        </picture>
        <canvas class="nodus-title-canvas"></canvas>
      </nodus-title>
      <div class="hero-copy">
        <p>
          From robot control to Physical AI.<br class="mobile-break" /> Projects built,
          tested, and set in motion.
        </p>
        <a class="hero-explore" href="#project-gallery"
          ><span>Explore the projects</span><svg
            viewBox="0 0 24 24"
            aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"></path></svg
          ></a
        >
      </div>
    </section>

    <section
      class="nodus-projects"
      id="project-gallery"
      aria-labelledby="gallery-title"
    >
      <div class="gallery-heading">
        <div>
          <h2 id="gallery-title">From experiments to reality.</h2>
        </div>
        <div class="gallery-tools">
          <span class="hover-hint"><span></span>Hover to play</span><button
            class="motion-toggle"
            type="button"
            data-motion-toggle
            aria-pressed="false"
            aria-label="Pause background motion"
            ><svg viewBox="0 0 20 20" aria-hidden="true" class="pause-icon"
              ><path d="M7 5v10M13 5v10"></path></svg
            ><svg viewBox="0 0 20 20" aria-hidden="true" class="play-icon"
              ><path d="m7 4 9 6-9 6Z"></path></svg
            ><span>Motion on</span></button
          >
        </div>
      </div>

      <nodus-gallery
        class="nodus-gallery"
        role="region"
        aria-roledescription="carousel"
        aria-label="Project cards"
        tabindex="0"
      >
        <button
          class="axis-entry"
          type="button"
          data-axis-open
          aria-expanded="false"
          aria-controls="professional-experience"
          aria-label="Open professional experience: scroll down here or click"
        >
          <span class="axis-scroll-mouse" aria-hidden="true"><span></span></span
          >
          <span class="axis-entry-copy"
            ><span class="axis-entry-title">Professional Experience</span><span
              class="axis-entry-hint"
              >Scroll down here to explore · or click</span
            ></span
          >
          <span class="axis-entry-mark" aria-hidden="true">↓</span>
        </button>
        <div class="gallery-window">
          <div class="gallery-floor" aria-hidden="true"></div>
          <div class="axis-project-layer">
            <div class="gallery-stage">
              {
                projects.map(
                  (
                    {
                      post,
                      title,
                      category,
                      coverAlt,
                      timelineAt,
                      timelineDate,
                      timelineLabel,
                    },
                    index
                  ) => (
                    <div
                      class="project-slot"
                      data-card-slot
                      style={`--card-order:${index}`}
                    >
                      <div class="card-float">
                        <a
                          class="project-card"
                          href={getPostUrl(post.id, post.filePath)}
                          data-card
                          data-preview={post.data.previewVideo}
                          data-youtube={post.data.previewYoutube}
                          aria-label={title}
                          data-timeline-at={timelineAt.toISOString()}
                          data-timeline-date={timelineDate}
                          data-timeline-label={timelineLabel}
                        >
                          <canvas
                            class="nodus-surface"
                            width="1"
                            height="1"
                            data-surface-color="#161d23"
                            aria-hidden="true"
                          />
                          <div class="card-media">
                            <img
                              src={
                                post.data.cover ??
                                "/media/images/motion-planning.jpg"
                              }
                              alt={coverAlt}
                              width="768"
                              height="480"
                              loading={index < 2 ? "eager" : "lazy"}
                              decoding="async"
                            />
                            <canvas
                              class="card-thumbnail"
                              width="1"
                              height="1"
                              data-thumbnail-canvas
                              aria-hidden="true"
                            />
                            {post.data.previewVideo && (
                              <video
                                muted
                                loop
                                playsinline
                                preload="none"
                                aria-hidden="true"
                                disablepictureinpicture
                                data-local-preview
                              >
                                <source
                                  data-src={post.data.previewVideo}
                                  type="video/mp4"
                                />
                              </video>
                            )}
                            <div class="card-vignette" />
                            <span class="card-category">{category}</span>
                            <span class="preview-status">
                              <>
                                <svg viewBox="0 0 16 16" aria-hidden="true">
                                  <path d="m6 3 7 5-7 5Z" />
                                </svg>
                                <span data-preview-label>Preview</span>
                              </>
                            </span>
                          </div>
                          <div class="card-copy">
                            <>
                              <div class="card-date">
                                <>
                                  <span>
                                    {new Intl.DateTimeFormat("en", {
                                      month: "short",
                                      year: "numeric",
                                    }).format(timelineAt)}
                                  </span>
                                  <span>
                                    {String(index + 1).padStart(2, "0")}
                                  </span>
                                </>
                              </div>
                              <h3>{title}</h3>
                              <div class="card-bottom">
                                <>
                                  <span>Explore project</span>
                                  <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M6 18 18 6M6 6h12v12" />
                                  </svg>
                                </>
                              </div>
                            </>
                          </div>
                        </a>
                        {(post.data.previewVideo ||
                          post.data.previewYoutube) && (
                          <button
                            type="button"
                            class="touch-preview"
                            data-touch-preview
                            aria-label={`Preview video: ${title}`}
                            aria-pressed="false"
                          >
                            <svg viewBox="0 0 20 20" aria-hidden="true">
                              <path d="m7 4 9 6-9 6Z" />
                            </svg>
                            <span>Video preview</span>
                          </button>
                        )}
                      </div>
                      <div class="card-ground-shadow" aria-hidden="true" />
                    </div>
                  )
                )
              }
            </div>
          </div>
          <NodusExperience />
        </div>
        <div class="gallery-controls">
          <div class="gallery-position">
            <span data-current-number
              >{String(posts.length).padStart(2, "0")}</span
            ><span class="position-rule"></span><span
              >{String(posts.length).padStart(2, "0")}</span
            >
          </div>
          <div class="gallery-timeline">
            <span class="timeline-label">Timeline</span>
            <time
              class="timeline-date"
              data-current-date
              data-value={initialProject.timelineDate}
              datetime={initialProject.timelineAt.toISOString()}
            >
              <span class="nodus-accessible" data-current-date-label
                >{initialProject.timelineLabel}</span
              >
              <span class="date-reels" aria-hidden="true">
                {
                  [...initialProject.timelineDate].map(character =>
                    character === "." ? (
                      <span class="date-separator">.</span>
                    ) : (
                      <span class="date-digit">
                        <span
                          class="date-digit-strip"
                          data-date-digit={character}
                          style={`transform:translateY(-${Number(character)}em)`}
                        >
                          {digitSequence}
                        </span>
                      </span>
                    )
                  )
                }
              </span>
            </time>
            <div class="gallery-dots" aria-label="Select a project">
              {
                projects.map(({ title }, index) => (
                  <button
                    type="button"
                    data-select-card={index}
                    aria-label={`Project ${index + 1}: ${title}`}
                    aria-pressed={index === projects.length - 1}
                  >
                    <span />
                  </button>
                ))
              }
            </div>
          </div>
          <div class="gallery-arrows">
            <button type="button" data-previous aria-label="Previous project"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M19 12H5m6-6-6 6 6 6"></path></svg
              ></button
            ><button type="button" data-next aria-label="Next project"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
              ></button
            >
          </div>
        </div>
        <p
          class="nodus-accessible"
          role="status"
          aria-live="polite"
          data-gallery-announcement
        >
        </p>
      </nodus-gallery>
      <div class="collection-footer">
        <p>
          <span class="desktop-instruction"
            >Scroll or drag to browse. Hover to preview. Click to explore.</span
          ><span class="mobile-instruction">Swipe to explore the projects.</span
          >
        </p><a href="/posts/"
          >View all posts <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
          ></a
        >
      </div>
    </section>
  </main>
  <footer class="nodus-footer">
    <span>© {new Date().getFullYear()} Project Nodus</span><span
      class="footer-note">A personal exploration of robotics.</span
    ><div>
      <a href="/about/">Junggil Yun</a><span aria-hidden="true">/</span><a
        href="/rss.xml">RSS</a
      >
    </div>
  </footer>
</div>
<script>
  import "@/scripts/nodus-home";
</script>
