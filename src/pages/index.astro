---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import NodusHome from "@/components/NodusHome.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";

const posts = getSortedPosts(await getCollection("posts")).sort(
  (a, b) =>
    (a.data.homeDate ?? a.data.pubDatetime).getTime() -
    (b.data.homeDate ?? b.data.pubDatetime).getTime()
);
---

<Layout
  title="Project Nodus"
  lang="en"
  description="Exploring robot control, motion planning, and Physical AI through hands-on projects and experiments."
>
  <NodusHome posts={posts} />
</Layout>
